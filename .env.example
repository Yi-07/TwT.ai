# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ModelScope (Alibaba Cloud DashScope)
DASHSCOPE_API_KEY=
MODELSCOPE_MODEL=qwen-plus

# Future providers: add key here + register in /lib/providers/index.ts and /lib/providers/registry.ts

# Default AI provider (claude | deepseek | modelscope)
NEXT_PUBLIC_DEFAULT_PROVIDER=deepseek

# App URL (client-side)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Debug mode (set to "true" to enable debug panel and verbose logging)
NEXT_PUBLIC_DEBUG=false

# Allow user settings panel (set to "false" in production to hide controls)
NEXT_PUBLIC_ALLOW_USER_SETTINGS=true

# Default model parameters (used as fallback when user settings are disabled)
DEFAULT_TEMPERATURE=1
DEFAULT_MAX_TOKENS=8192

