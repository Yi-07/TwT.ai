# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ModelScope (Alibaba Cloud DashScope)
DASHSCOPE_API_KEY=
MODELSCOPE_MODEL=qwen-plus

# Future providers: add key here + register in /lib/providers/index.ts and /lib/providers/registry.ts

# Default AI provider (claude | deepseek)
NEXT_PUBLIC_DEFAULT_PROVIDER=deepseek

# App URL (client-side)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
