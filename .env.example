# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ModelScope (Alibaba Cloud DashScope)
DASHSCOPE_API_KEY=
MODELSCOPE_MODEL=qwen-plus

# Custom providers — JSON array of OpenAI-compatible endpoints (server-side only)
# CUSTOM_PROVIDERS=[{"id":"openrouter","name":"OpenRouter","type":"openai-compatible","apiKey":"sk-...","baseUrl":"https://openrouter.ai/api/v1","model":"openai/gpt-4o"}]

# Server-side persistence — set to "server" to use PostgreSQL (Neon)
# Leave unset to default to browser IndexedDB
# NEXT_PUBLIC_STORAGE_MODE=server
# ACCESS_SECRET=
# NEXT_PUBLIC_ACCESS_SECRET=
# DATABASE_URL=postgres://...

# Default AI provider (claude | deepseek | modelscope)
NEXT_PUBLIC_DEFAULT_PROVIDER=deepseek

# App URL (client-side)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Debug mode (set to "true" to enable debug panel and verbose logging)
NEXT_PUBLIC_DEBUG=false

# Access password for private deployment (leave empty = public)
# ACCESS_PASSWORD=

# Default model parameters (shared between route.ts and Settings panel)
NEXT_PUBLIC_DEFAULT_TEMPERATURE=1
NEXT_PUBLIC_DEFAULT_MAX_TOKENS=131072

